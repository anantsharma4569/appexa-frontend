# The Frappe backend this site reads its content from, with no trailing slash.
#
# Leave unset for local development: the Vite proxy in vite.config.js forwards
# /api to the bench, so the site talks to its own origin.
#
# Set it when the frontend is hosted separately (Vercel, Netlify). The backend
# must allow this origin — see allow_cors in the backend README.
VITE_FRAPPE_URL=https://appexa.frappe.cloud
